<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Whole-assembly decompiler and IL dumper, built on the engine inside the installed ILSpy (the same
    references as ..\decompiler). Built on demand by ..\decompile-module.ps1. Its own folder because two
    SDK projects may not share one (their obj folders collide).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>decompmod</AssemblyName>
    <ILSpyDir Condition="'$(ILSpyDir)' == ''">$(LOCALAPPDATA)\Programs\ILSpy</ILSpyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(ILSpyDir)\ICSharpCode.Decompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Reflection.Metadata">
      <HintPath>$(ILSpyDir)\System.Reflection.Metadata.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
