<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A tiny command-line decompiler built on the engine inside the installed ILSpy.
    The ILSpy GUI ships ICSharpCode.Decompiler.dll, which is all this needs; ilspycmd is not required. Built on demand by ..\decompile.ps1 - you should not need to build it by hand.

    The two references are copied locally (Private=true): without that the tool builds fine and then
    fails at runtime with "Could not load file or assembly 'ICSharpCode.Decompiler'".
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>decomp</AssemblyName>
    <ILSpyDir Condition="'$(ILSpyDir)' == ''">$(LOCALAPPDATA)\Programs\ILSpy</ILSpyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(ILSpyDir)\ICSharpCode.Decompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Reflection.Metadata">
      <HintPath>$(ILSpyDir)\System.Reflection.Metadata.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
