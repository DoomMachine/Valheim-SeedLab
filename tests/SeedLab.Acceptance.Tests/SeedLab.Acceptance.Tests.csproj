<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- No NuGet: this machine may be offline and the user asked to be told before anything is
         installed. Tests are plain console asserts driven by Program.cs, run with dotnet run. -->
    <ProjectReference Include="..\..\src\SeedLab.WorldGen\SeedLab.WorldGen.csproj" />
    <ProjectReference Include="..\..\src\SeedLab.Seeds\SeedLab.Seeds.csproj" />
    <ProjectReference Include="..\..\src\SeedLab.Saves\SeedLab.Saves.csproj" />
    <!-- The world fingerprint (five SHA-256 layers per seed, placements included) and the location
         oracle it drives, for the profile-neutrality check. It brings Search, Locations, Data and
         Contracts with it; the terrain suite itself still uses none of them. -->
    <ProjectReference Include="..\..\src\SeedLab.LocationOracle\SeedLab.LocationOracle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fingerprints of the 64 reference seeds, recorded once with nothing wired to the profiler. -->
    <None Include="WorldFingerprintReference.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('WorldFingerprintReference.json')" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SeedLabAcceptanceTests</RootNamespace>
  </PropertyGroup>
</Project>
