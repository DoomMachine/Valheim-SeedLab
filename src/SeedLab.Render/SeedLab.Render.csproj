<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PNG map rendering: field sampling, the biome palette, the compositor and a hand-written PNG
    encoder/decoder over System.IO.Compression. No packages (SeedLab takes none) and no
    System.Drawing (Windows-only), so the same source renders on Windows, Linux and macOS.

    SeedLab.Data is deliberately NOT referenced: the only game data the renderer needs is the biome
    colour table, and that is the MEASURED prefab table from 05-validation.md section 2.1, hard-coded
    in MapPalette with its evidence. Add the reference if a dumped table ever supersedes it.

    SeedLab.Runtime is referenced for DurableWrite only (2026-09-24): PngEncoder.WriteFile writes a
    temp file and renames it over the target, so a kill never leaves a torn PNG and an image viewer
    holding the previous map is waited for and then named, instead of failing with a bare "Access to
    the path is denied.". Runtime references nothing, so this adds no cycle.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SeedLab.Render</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src/SeedLab.WorldGen\SeedLab.WorldGen.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src/SeedLab.Runtime\SeedLab.Runtime.csproj" />
  </ItemGroup>
</Project>
