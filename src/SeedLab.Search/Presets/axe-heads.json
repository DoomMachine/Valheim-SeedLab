{
  // Axe heads - a Meadows house that can hold an axe head, a short walk from spawn.
  //
  // RUNS TODAY.
  //
  // WHAT IT FINDS, AND WHAT IT CANNOT. Only two location prefabs in 1.0.15 can yield an axe head:
  // WoodHouse2 and WoodHouse6 (group:axe_head_houses, 20 of each per world). WHERE they are is a
  // function of the seed and this preset measures it exactly. WHAT IS INSIDE is not:
  //   WoodHouse6  its chest (TreasureChest_meadows_01) is a plain child, always there. A chest that
  //               exists yields the axe head 31 times in 56 (55.4 %) - DropTable.GetDropListItems,
  //               drawn from the UNSEEDED UnityEngine.Random when the chest first opens.
  //   WoodHouse2  its chest (TreasureChest_meadows_02) sits behind a RandomSpawn at 50 %. That coin
  //               IS seed-determined (the zone-seeded stream) but this build does not replay it yet,
  //               so the house is 31/112 (27.7 %) before the seed is consulted - and for any one
  //               seed it is really either 31/56 or zero.
  // Every result carries that note. No seed here promises an axe head; it promises the house.
  //
  // WHY THE GUARANTEED-CHEST HOUSE IS RANKED SEPARATELY. The two houses are equally common and
  // equally spread (below), and the nearest house is a WoodHouse6 in 270 of 512 seeds - so a
  // filter on the group alone treats a 27.7 % house as good as a 55.4 % one. The must-have keeps
  // any house close; the nice-to-have ranks the seeds whose WoodHouse6 is close too.
  //
  // DISTANCES ARE FROM SPAWN ("from": "spawn"), the StartTemple point this same location run
  // places - not the world centre, which is where the player never stands.
  //
  // COST: StartTemple, WoodHouse2 and WoodHouse6 sit at 52 of 183 ordered entries, so a seed runs
  // that prefix (every earlier type can take a later one's zone, so it cannot be shorter). MEASURED
  // 2026-09-24, 256 seeds, --block-size 16, 8 workers (balanced mode): 61.6 s, 4.2 seeds/s.
  // (Until 2026-09-24 a plain '--seeds 512' was only 2 blocks of 256, so 2 of the 8 workers got work
  // and it ran at 1.3 seeds/s - that was the block size, not this preset. Left out, the block size is
  // now automatic: 512 seeds on 8 workers is 32 blocks of 16.)
  //
  // NO "grid" ON PURPOSE. Every goal here is a location goal, and a location run builds its own
  // 2048^2 biome-point grid whatever the query says. The same 256-seed run at G384 took 60.1 s
  // (4.3 seeds/s), and three seeds explained at G384 gave distances bit-identical to the G12 sample.
  // A coarse grid buys nothing here: it changes no value, only the run hash (and so the checkpoint
  // and which seeds a shuffled sample visits), and the plan says exactly that.
  "version": 1,
  "defs": 1,
  "name": "axe-heads",
  "description": "An axe-head house (WoodHouse2 or WoodHouse6) within 150 m of spawn, ranking the house whose chest always exists. Candidate houses, not promised axe heads: what a chest holds is not decided by the seed.",
  "world": { "gen_version": 2 },
  "search": { "order": "shuffled", "keep": 50 },
  "goals": [
    { "id": "house-close", "target": "group:axe_head_houses", "metric": "nearest_distance",
      "from": "spawn", "test": "near", "value": 150, "importance": "must" },
    // MEASURED on two independent 512-seed samples (2026-09-24, both shuffled over the whole
    // int32 range, no seed in common): the nearest axe-head house from spawn has p25 117 / 124 m,
    // median 189 / 194 m, p90 364 m, minimum 37 / 38 m, maximum 916 / 1,080 m. Every one of the
    // 1,024 seeds places all 40 houses. Within 150 m: 192 of 512 (37.5 %) and 194 of 512 (37.9 %).

    { "id": "guaranteed-chest-close", "target": "location:WoodHouse6", "metric": "nearest_distance",
      "from": "spawn", "test": "near", "value": 400, "importance": "nice", "weight": 2 },
    // MEASURED (the second sample): nearest WoodHouse6 from spawn p25 173 m, median 273 m, p90
    // 492 m, so the score 1 - d/400 is non-zero for 77 % of all seeds and 89 % of the seeds that
    // pass the must-have (their median is 141 m). WoodHouse2 alone: p25 182, median 269 m.

    { "id": "more-houses", "target": "group:axe_head_houses", "metric": "count_within",
      "radius": 500, "from": "spawn", "test": "at_least", "value": 8, "importance": "nice" }
    // More houses near home is more chests to try. MEASURED: 0 to 12 houses within 500 m of spawn,
    // median 4 over all seeds and 5 over the must-have's survivors; 8 or more in 16 % of those.
  ]
}
