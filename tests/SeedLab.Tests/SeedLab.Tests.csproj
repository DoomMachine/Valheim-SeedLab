<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- No NuGet: this machine may be offline and the user asked to be told before anything is
         installed. Tests are plain console asserts driven by Program.cs, run with dotnet run. -->
    <ProjectReference Include="..\..\src\SeedLab.WorldGen\SeedLab.WorldGen.csproj" />
    <ProjectReference Include="..\..\src\SeedLab.Seeds\SeedLab.Seeds.csproj" />
    <ProjectReference Include="..\..\src\SeedLab.Saves\SeedLab.Saves.csproj" />
    <!-- The profile tripwire reads the IL of WorldGen, Locations, LocationOracle and the search
         evaluator, so those assemblies must sit beside the test. The river golden calls one thing
         in them: PilotSeedOrder, the profile's fixed seed order. -->
    <ProjectReference Include="..\..\src\SeedLab.LocationOracle\SeedLab.LocationOracle.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SeedLabTests</RootNamespace>
  </PropertyGroup>
</Project>
