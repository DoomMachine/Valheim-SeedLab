<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The runtime/resource layer's own test suite. Dependency-free, like the other SeedLab suites: a
    console program that exits 0 when every check passes and 1 when one does not.

      dotnet run (project tests\SeedLab.Runtime.Tests, configuration Release)
      ... with the argument "probe" (two dashes, "probe") to print this machine
      ... with the argument "emit-vectors" (two dashes) to re-record the goldens

    Everything that touches the machine is tested through an override or a fake - a fake process lister,
    an overridden core and memory count, a temporary cache root - so the suite gives the same answer on
    a laptop, in a container and on a build agent.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SeedLab.Runtime.Tests</AssemblyName>
    <RootNamespace>SeedLab.RuntimeTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SeedLab.Runtime\SeedLab.Runtime.csproj" />
  </ItemGroup>
</Project>
